# Public frontend values only (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Optional SaaS base domain for real subdomains (e.g. ijaaro.app → slug.ijaaro.app)
# VITE_TENANT_BASE_DOMAIN=ijaaro.app

# Server-only — never put these in frontend code or commit real values
# Used for security tests and privileged bootstrap tooling
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Edge Function secrets for provision-renter (set in Supabase Functions env, not Vite):
# PUBLIC_SITE_URL=https://your-app-origin          # invite redirect → /set-password
# PROVISION_RENTER_EMAIL_DELIVERY_READY=true       # ONLY after Auth invite email delivery is verified
# Without PROVISION_RENTER_EMAIL_DELIVERY_READY=true the function fails closed (503).
