# --- Frontend public Supabase config (safe for the browser) ---
# Copy to .env.local and fill Live project values (never commit real secrets).
#
# Required for `npm run dev` (vite --mode live) and `npm run build`:
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<publishable/anon key>
#   VITE_ALLOW_REMOTE_SUPABASE=true
#
# Then: npm run env:live   # writes gitignored .env.live.local for vite --mode live
#       npm run dev        # http://127.0.0.1:5173 → Live Supabase
#
# Do NOT put service-role keys in VITE_* variables.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_ALLOW_REMOTE_SUPABASE=true

# Optional SaaS base domain for real subdomains (e.g. ijaaro.app → slug.ijaaro.app).
# Leave empty on localhost — the app uses slug.localhost:port instead.
# VITE_TENANT_BASE_DOMAIN=ijaaro.app

# Optional for security tests run from frontend/ (never prefix with VITE_).
# Prefer frontend/.env.isolated for Vitest against an isolated local Supabase.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
