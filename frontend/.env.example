VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Optional SaaS base domain for real subdomains (e.g. ijaaro.app → slug.ijaaro.app).
# Leave empty on localhost — the app uses slug.localhost:port instead.
# VITE_TENANT_BASE_DOMAIN=ijaaro.app

# Optional for security tests run from frontend/
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
